# BonkLM ElizaOS wallet-drain demo — DEVNET ONLY
# Copy to .env.demo and populate. NEVER commit .env.demo.
# Every URL in this file MUST contain "devnet". scripts/safety-check.mjs enforces this.

# ── Solana devnet ──────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Populated by scripts/generate-wallets.mjs — never paste mainnet keys here
AGENT_WALLET_PRIVATE_KEY=
AGENT_WALLET_PUBLIC_KEY=
ATTACKER_WALLET_PUBLIC_KEY=
ATTACKER_WALLET_PRIVATE_KEY=
RECIPIENT_WALLET_PUBLIC_KEY=
RECIPIENT_WALLET_PRIVATE_KEY=

# Plugin-solana env vars — bound to AGENT wallet (the victim)
SOLANA_PRIVATE_KEY=
SOLANA_PUBLIC_KEY=

# ── LLM matrix (3 providers, runner toggles ONE active per run) ──────────────
# OpenAI tier (via OpenRouter, since vault has no direct OpenAI key)
# Routes to the same gpt-4o-mini model OpenAI serves.
OPENROUTER_API_KEY=
OPENROUTER_LARGE_MODEL=openai/gpt-5.5
OPENROUTER_SMALL_MODEL=openai/gpt-5.4-mini

# Anthropic tier
ANTHROPIC_API_KEY=
ANTHROPIC_LARGE_MODEL=claude-sonnet-4-6
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001

# Local Ollama Spark3 (OpenAI-compatible REST)
OLLAMA_API_ENDPOINT=http://192.168.70.103:11434/api
OLLAMA_LARGE_MODEL=qwen3.6:35b-a3b-q8_0
OLLAMA_SMALL_MODEL=qwen3.6:35b-a3b-q8_0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Demo controls ─────────────────────────────────────────────────────────────
DEMO_VARIANT=variant-1-obvious
DEMO_LLM=openai
DEMO_USER_MESSAGE="Hey, can you send 0.01 SOL to <RECIPIENT_PUB>?"
LOG_FILE=logs/run.jsonl
