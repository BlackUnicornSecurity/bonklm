{
  "name": "@blackunicorn/bonklm-workspace",
  "version": "1.0.16",
  "description": "BonkLM - LLM Security Guardrails for prompt injection, jailbreak, and content validation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "docker:build": "pnpm --filter @blackunicorn/bonklm-server run docker:build",
    "docker:smoke": "bash scripts/smoke-container.sh",
    "verify:surface": "node scripts/verify-publish-surface.mjs",
    "audit:prod": "node scripts/supply-chain-audit.mjs",
    "license-check": "node scripts/license-audit.mjs",
    "sbom": "node scripts/gen-sbom.mjs",
    "scan:tarballs": "bash scripts/scan-tarballs.sh",
    "check:release-tarballs": "node scripts/check-release-tarballs.js",
    "check:changeset-linked": "node tools/check-changeset-linked.js",
    "check:release-plan": "node tools/check-release-plan.js",
    "check:gitleaks-ignore": "node tools/check-gitleaks-ignore.js",
    "check:diff-coverage": "node tools/check-diff-coverage.js",
    "check:workspace-policy": "node tools/check-workspace-policy.js",
    "check:ee-boundary": "node tools/check-ee-boundary.js",
    "check:edge-node-builtins": "node tools/check-edge-node-builtins.js",
    "check:stale-dist": "node tools/check-stale-dist.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "pnpm -r --if-present test:types",
    "test:pack": "vitest run --config vitest.pack.config.ts",
    "benchmark": "vitest bench --config vitest.config.ts packages/core/benchmarks/benchmark.bench.ts",
    "benchmark:micro": "vitest bench --config vitest.config.ts packages/core/benchmarks/micro.bench.ts",
    "benchmark:cold-start": "node packages/core/benchmarks/cold-start.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yaml,yml}\"",
    "clean": "pnpm -r --filter \"@blackunicorn/*\" run clean",
    "dev": "pnpm --filter ./packages/core run dev",
    "uat": "tsx packages/core/uat/run-uat.ts",
    "quality-gate": "bash scripts/quality-gate.sh",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && node tools/sync-root-version.js && pnpm install --no-frozen-lockfile",
    "prepare": "if [ \"$CI\" = \"true\" ]; then exit 0; else simple-git-hooks; fi"
  },
  "keywords": [
    "llm",
    "security",
    "guardrails",
    "prompt-injection",
    "jailbreak",
    "ai-safety",
    "validation",
    "openclaw"
  ],
  "author": "BlackUnicorn <info@blackunicorn.tech>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-yml": "^3.2.1",
    "npm-package-arg": "^11.0.3",
    "prettier": "^3.8.1",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.13.1",
    "ts-morph": "^28.0.0",
    "tsd": "^0.33.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.4.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.6 <8",
      "@grpc/grpc-js": ">=1.14.4 <2",
      "@hono/node-server": ">=1.19.15 <2",
      "@modelcontextprotocol/sdk": ">=1.25.2 <2",
      "@nestjs/common": ">=11.1.18 <12",
      "@nestjs/core": ">=11.1.18 <12",
      "@nestjs/platform-express": ">=11.1.18 <12",
      "@opentelemetry/auto-instrumentations-node": ">=0.75.0 <1",
      "@opentelemetry/core": ">=2.8.0 <3",
      "@opentelemetry/propagator-jaeger": ">=2.9.0 <3",
      "@opentelemetry/sdk-node": ">=0.217.0 <1",
      "@tootallnate/once": ">=2.0.1 <3",
      "@trigger.dev/core": ">=4.5.6 <5",
      "axios": ">=1.18.0 <2",
      "body-parser@1": ">=1.20.6 <2",
      "body-parser@2": ">=2.3.0 <3",
      "dompurify": ">=3.4.13 <4",
      "engine.io": ">=6.6.7 <7",
      "esbuild": ">=0.28.1 <0.29",
      "express-rate-limit": ">=8.2.2 <9",
      "fast-uri": ">=3.1.1 <4",
      "fastify": ">=5.8.5 <6",
      "file-type": ">=21.3.1 <22",
      "form-data": ">=4.0.6 <5",
      "form-data@2": ">=2.5.6 <3",
      "handlebars": ">=4.7.9 <5",
      "hono": ">=4.12.34 <5",
      "ip-address": ">=10.3.1 <11",
      "js-yaml@3": ">=3.15.1 <4",
      "js-yaml@4": ">=4.3.1 <5",
      "jsondiffpatch": ">=0.7.2 <0.8",
      "langsmith": ">=0.6.0 <1",
      "linkify-it": ">=5.0.2 <6",
      "lodash": ">=4.18.0 <5",
      "lodash-es": ">=4.18.0 <5",
      "mermaid": ">=11.16.1 <12",
      "minimatch": ">=9.0.6 <10",
      "mongoose": ">=9.7.2 <10",
      "multer": ">=2.2.0 <3",
      "nanoid@3": ">=3.3.18 <4",
      "nanoid@5": ">=5.1.16 <6",
      "next@16": ">=16.2.11 <17",
      "openclaw": ">=2026.6.5 <2027.0.0",
      "path-to-regexp": ">=8.4.0 <9",
      "pdfjs-dist": ">=6.2.108 <7",
      "picomatch@4": ">=4.0.4 <5",
      "postcss@8": ">=8.5.23 <9",
      "protobufjs@8": ">=8.6.6 <9",
      "qs": ">=6.15.2 <7",
      "sharp": ">=0.35.0 <0.36",
      "shell-quote": ">=1.9.0 <2",
      "socket.io-parser": ">=4.2.7 <5",
      "systeminformation": ">=5.31.7 <6",
      "tar": ">=7.5.19 <8",
      "thrift": ">=0.23.0 <1",
      "ts-deepmerge": ">=8.0.0 <9",
      "undici": ">=8.10.0 <9",
      "uuid@10": ">=11.1.1 <12",
      "uuid@9": ">=11.1.1 <12",
      "vite": ">=7.3.6 <8",
      "websocket-driver": ">=0.7.5 <0.8",
      "ws": ">=8.21.0 <9",
      "yaml": ">=2.8.3 <3"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check:gitleaks-ignore && gitleaks protect --staged --config .gitleaks.toml --redact --no-banner && pnpm format:check && pnpm lint && pnpm typecheck && bash scripts/check-version-pin.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackUnicornSecurity/bonklm"
  },
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm#readme",
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
