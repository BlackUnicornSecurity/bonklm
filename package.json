{
  "name": "@blackunicorn-bonklm",
  "version": "0.3.0",
  "description": "BonkLM - LLM Security Guardrails for prompt injection, jailbreak, and content validation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"@blackunicorn/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest bench --config vitest.config.ts packages/core/benchmarks/benchmark.bench.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yaml,yml}\"",
    "clean": "pnpm -r --filter \"@blackunicorn/*\" run clean",
    "dev": "pnpm --filter ./packages/core run dev",
    "uat": "tsx packages/core/uat/run-uat.ts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "keywords": [
    "llm",
    "security",
    "guardrails",
    "prompt-injection",
    "jailbreak",
    "ai-safety",
    "validation",
    "openclaw"
  ],
  "author": "Black Unicorn <security@blackunicorn.tech>",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-yml": "^3.2.1",
    "prettier": "^3.8.1",
    "ts-morph": "^28.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/blackunicorn/bonklm"
  },
  "bugs": {
    "url": "https://github.com/blackunicorn/bonklm/issues"
  },
  "homepage": "https://github.com/blackunicorn/bonklm#readme",
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
