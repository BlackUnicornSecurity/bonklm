{
  "name": "@blackunicorn/bonklm-daytona",
  "version": "1.0.16",
  "description": "Daytona Workspace wrapper for BonkLM. Proxies process.* + fs.* with code-injection + path-traversal validation. EXPERIMENTAL (Story 3.5).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "test:types": "tsd"
  },
  "keywords": [
    "daytona",
    "sandbox",
    "code-execution",
    "guardrails",
    "security",
    "experimental",
    "ai-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/daytona-adapter"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm",
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "author": "BlackUnicorn <info@blackunicorn.tech>",
  "license": "Apache-2.0",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*",
    "@blackunicorn/bonklm-sandbox-utils": "workspace:*"
  },
  "peerDependencies": {
    "@daytonaio/sdk": "~0.175.0"
  },
  "peerDependenciesMeta": {
    "@daytonaio/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
