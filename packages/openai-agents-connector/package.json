{
  "name": "@blackunicorn/bonklm-openai-agents",
  "version": "0.6.0",
  "description": "OpenAI Agents SDK connector for BonkLM — wraps Agent / Handoff / Realtime surfaces with guardrails",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "openai",
    "openai-agents",
    "agents",
    "handoff",
    "realtime",
    "llm",
    "guardrails",
    "security",
    "prompt-injection",
    "validation"
  ],
  "author": "Black Unicorn <security@blackunicorn.tech>",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "@openai/agents": "^0.11.0"
  },
  "peerDependenciesMeta": {
    "@openai/agents": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
