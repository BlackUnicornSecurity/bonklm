{
  "name": "@blackunicorn/bonklm-google-genai",
  "version": "1.0.0-rc.4",
  "description": "Google GenAI SDK (@google/genai) connector for BonkLM — covers Gemini Developer API, Vertex AI, and Live API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "google",
    "gemini",
    "vertex-ai",
    "google-genai",
    "llm",
    "guardrails",
    "security",
    "prompt-injection",
    "jailbreak-detection",
    "content-filtering"
  ],
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "@google/genai": "^1.2.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
