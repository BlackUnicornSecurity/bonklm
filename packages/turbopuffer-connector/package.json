{
  "name": "@blackunicorn/bonklm-turbopuffer",
  "version": "1.0.0-rc.4",
  "description": "Turbopuffer Namespace wrapper for BonkLM — edge-compatible (Workerd/Deno/Bun/Vercel Edge) MemoryWriteValidator + RetrievedDocValidator guardrails",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "turbopuffer",
    "vector",
    "vector-database",
    "edge",
    "workerd",
    "vercel-edge",
    "rag",
    "memory",
    "llm",
    "guardrails",
    "security",
    "prompt-injection",
    "ai-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/turbopuffer-connector"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm",
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "author": "BlackUnicorn <info@blackunicorn.tech>",
  "license": "Apache-2.0",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "@turbopuffer/turbopuffer": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@turbopuffer/turbopuffer": {
      "optional": false
    }
  },
  "devDependencies": {
    "@turbopuffer/turbopuffer": "^2.1.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
