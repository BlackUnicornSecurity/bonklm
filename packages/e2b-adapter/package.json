{
  "name": "@blackunicorn/bonklm-e2b",
  "version": "1.0.0-rc.3",
  "description": "E2B Sandbox wrapper for BonkLM. Proxies commands.run / runCode / files.* with code-injection + path-traversal validation. EXPERIMENTAL (Story 3.5).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "e2b",
    "sandbox",
    "code-execution",
    "guardrails",
    "security",
    "experimental",
    "ai-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/e2b-adapter"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm",
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "author": "Black Unicorn <security@blackunicorn.tech>",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*",
    "@blackunicorn/bonklm-sandbox-utils": "workspace:*"
  },
  "peerDependencies": {
    "@e2b/code-interpreter": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@e2b/code-interpreter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
