{
  "name": "@blackunicorn/bonklm-browser-agents-core",
  "version": "0.5.0",
  "description": "BonkLM browser-agent normalised event union + guardrail factory. Underpins stagehand-connector + eko-connector.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "browser-agent",
    "stagehand",
    "eko",
    "llm",
    "guardrails",
    "security"
