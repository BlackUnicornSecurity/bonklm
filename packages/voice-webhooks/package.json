{
  "name": "@blackunicorn/bonklm-voice-webhooks",
  "version": "1.0.0-rc.4",
  "description": "Vapi (HTTP) + Retell (WebSocket) webhook validators for BonkLM. HMAC-SHA256 auth, sync tool-calls / assistant-request, async transcript observe-only, Retell update_only + response_required.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vapi": {
      "import": "./dist/vapi/index.js",
      "types": "./dist/vapi/index.d.ts",
      "default": "./dist/vapi/index.js"
    },
    "./retell": {
      "import": "./dist/retell/index.js",
      "types": "./dist/retell/index.d.ts",
      "default": "./dist/retell/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "vapi",
    "retell",
    "webhook",
    "voice",
    "realtime",
    "guardrails",
    "security",
    "prompt-injection",
    "hmac",
    "ai-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/voice-webhooks"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm",
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "author": "BlackUnicorn <info@blackunicorn.tech>",
  "license": "Apache-2.0",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
