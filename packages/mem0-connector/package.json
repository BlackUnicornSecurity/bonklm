{
  "name": "@blackunicorn/bonklm-mem0",
  "version": "1.0.0-rc.4",
  "description": "Mem0 memory-client connector for BonkLM — wraps Mem0's add/search/update/get/getAll/history/reset with sealed write + composed-context recall validation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "deno": "./dist/index.js",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mem0",
    "memory",
    "llm",
    "guardrails",
    "security",
    "ai-safety",
    "bonklm"
  ],
  "author": "Black Unicorn <info@blackunicorn.tech>",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*",
    "@blackunicorn/bonklm-memory-utils": "workspace:*"
  },
  "peerDependencies": {
    "mem0ai": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "mem0ai": {
      "optional": false
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
