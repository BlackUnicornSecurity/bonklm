{
  "name": "@blackunicorn/bonklm-ollama",
  "version": "1.0.0-rc.4",
  "description": "Ollama SDK connector for BonkLM",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ollama",
    "llm",
    "guardrails",
    "security",
    "prompt-injection",
    "jailbreak-detection",
    "content-filtering",
    "local-llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/ollama-connector"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "ollama": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "ollama": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "ollama": "^0.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
