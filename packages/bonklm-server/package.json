{
  "name": "@blackunicorn/bonklm-server",
  "version": "1.0.0-rc.3",
  "description": "BonkLM Guardrail HTTP server — Fastify service exposing /litellm, /portkey, /openai-compatible endpoints with HMAC-SHA256 auth for LiteLLM + Portkey integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bonklm-server": "./dist/bin/server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hmac": {
      "import": "./dist/hmac/index.js",
      "types": "./dist/hmac/index.d.ts"
    }
  },
  "files": [
    "dist",
    "Dockerfile",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t blackunicorn/bonklm-server:$(node -p \"require('./package.json').version\") ."
  },
  "keywords": [
    "bonklm",
    "fastify",
    "guardrails",
    "llm",
    "security",
    "litellm",
    "portkey",
    "openai-compatible",
    "hmac",
    "prompt-injection",
    "ai-safety",
    "server",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/bonklm-server"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm",
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "author": "Black Unicorn <security@blackunicorn.tech>",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
