{
  "name": "@blackunicorn/bonklm-llamaindex",
  "version": "1.0.0-rc.4",
  "description": "LlamaIndex.TS connector for BonkLM - RAG query and retrieval validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd"
  },
  "keywords": [
    "llamaindex",
    "rag",
    "vector",
    "llm",
    "guardrails",
    "security",
    "retrieval",
    "prompt-injection",
    "validation"
  ],
  "author": "BlackUnicorn",
  "license": "Apache-2.0",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "llamaindex": "^0.11.0 || ^0.12.0"
  },
  "peerDependenciesMeta": {
    "llamaindex": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
