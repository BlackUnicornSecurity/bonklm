  "keywords": [
    "stagehand",
    "browserbase",
    "browser-agent",
    "llm",
    "guardrails",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/stagehand-connector"
  },
  "homepage": "https://github.com/BlackUnicornSecurity/bonklm",
  "bugs": {
    "url": "https://github.com/BlackUnicornSecurity/bonklm/issues"
  },
  "author": "Black Unicorn <security@blackunicorn.tech>",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*",
    "@blackunicorn/bonklm-browser-agents-core": "workspace:*"
  },
  "peerDependencies": {
    "@browserbasehq/stagehand": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@browserbasehq/stagehand": {
      "optional": false
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
