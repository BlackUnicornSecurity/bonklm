{
  "name": "@blackunicorn/bonklm-mcp",
  "version": "1.0.14",
  "description": "MCP SDK connector for BonkLM",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test:types": "tsd"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "guardrails",
    "security",
    "tool-validation",
    "prompt-injection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackUnicornSecurity/bonklm.git",
    "directory": "packages/mcp-connector"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
