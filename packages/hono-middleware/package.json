{
  "name": "@blackunicorn/bonklm-hono",
  "version": "1.0.0-rc.1",
  "description": "Hono middleware for BonkLM — edge-runtime-native LLM security guardrails",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "deno": "./dist/index.js",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
