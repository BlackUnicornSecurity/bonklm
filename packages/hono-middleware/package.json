    "hono": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": false
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "hono": "^4.12.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
