{
  "name": "@blackunicorn/bonklm-huggingface",
  "version": "1.0.0-rc.4",
  "description": "HuggingFace Inference API connector for BonkLM - Model input/output validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:types": "tsd"
  },
  "tsd": {
    "compilerOptions": {
      "composite": false
    }
  },
  "keywords": [
    "huggingface",
    "llm",
    "guardrails",
    "security",
    "inference",
    "prompt-injection",
    "validation",
    "transformers"
  ],
  "author": "Black Unicorn",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "peerDependencies": {
    "@huggingface/inference": "^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/inference": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
