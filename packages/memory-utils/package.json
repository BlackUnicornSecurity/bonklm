{
  "name": "@blackunicorn/bonklm-memory-utils",
  "version": "0.5.0",
  "description": "Shared memory-client wrapping primitives for BonkLM (consumed by mem0/zep/letta/future vendor connectors)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "deno": "./dist/index.js",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": ["memory", "llm", "guardrails", "security", "ai-safety", "bonklm"],
  "author": "Black Unicorn <security@blackunicorn.tech>",
  "license": "MIT",
  "dependencies": {
    "@blackunicorn/bonklm": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
