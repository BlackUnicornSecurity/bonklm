# BonkLM .gitignore

# ===================
# Legacy framework leftovers (defensive — these directories should never
# come back into the repo)
# ===================
packages/wizard/src/
packages/wizard/dist/
packages/wizard/tests/

# ===================
# Node.js
# ===================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ===================
# Build Output
# ===================
dist/
build/
*.tsbuildinfo
*.map

# Package distribution artifacts
*.tgz
*.tar.gz
*.sha256
*.sbom.json

# Test coverage
coverage/

# ===================
# Environment Files
# ===================
.env
.env.local
.env.*.local
*.env

# ===================
# Security Keys & Certificates
# ===================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
*.pub

# ===================
# Internal team directory (CLAUDE.md: dev/planning/qa/security)
# ===================
team/

# ===================
# Local agent-harness artifacts (same class as .claude/ below) — generated
# per-machine by non-Claude agent CLIs; never part of the library.
# AGENTS.md + CLAUDE.md are both generated by Infra/gen_rules.py (from Infra/rules
# + .rules). AGENTS.md is the canonical anchor but kept untracked here; CLAUDE.md
# is the committed generated surface. Edit rules in Infra/rules or .rules — never
# these files.
# ===================
.agents/
.codex/
AGENTS.md

# ===================
# Claude Code local settings
# ===================
.claude/settings.local.json
.claude/audio/
.claude/projects/
.claude/logs/
.claude/.rate_limit_state.json
.claude/.confidence_state.json
.claude/.override_state.json
.claude/.resource_state.json
.claude/.session_claims.json
.claude/.session_validated
.claude/*.lock
.claude/dashboard.html
.claude/github-star-reminder.txt
.claude/llm-provider.txt
# Local-harness validator runtime state, incl. the kill-switch sentinel
# (also covered by .claude/.gitignore; duplicated here so ship-safety does not
# depend on the nested ignore file alone).
.claude/validators-node/state/

# ===================
# Editor / IDE
# ===================
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ===================
# OS Generated
# ===================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================
# Editor backup files
# ===================
*.bak
*.backup
*.old
*.orig

# ===================
# Logs and Temp
# ===================
*.tmp
*.temp
.cache/

# Test debug scratch
packages/*/output.txt
packages/*/test_debug.js
test_*.js
*.json.bak

# ===================
# Misc binary assets (move to assets/ if needed)
# ===================
*.pptx

# Codemod runtime output — regenerated by scripts/codemod-noop-validator.ts
scripts/codemod-report.json

# Local screenshot scratch from playwright-mcp explorations
.playwright-mcp/
landing-*.png
playground-*.png

# ===================
# demo/ runtime state — never commit; the doc/script subset is committed
# separately. wallets/ contains keypair JSONs that must never enter version
# control regardless of devnet/testnet classification — per CLAUDE.md
# "Never commit secrets, PII, or .env files".
# ===================
demo/*/node_modules/
demo/*/.eliza/
demo/*/wallets/
demo/*/recordings/
demo/*/screenshots/
demo/*/logs/
demo/*/evidence-tmp/
demo/*/bun.lock
# Belt-and-suspenders: per-demo .env files. Per-demo .gitignore files already
# exclude .env.*, but we mirror at root so demo env files can never enter
# version control through any path.
demo/**/.env
demo/**/.env.*
