.claude/.confidence_state.json
.claude/.override_state.json
.claude/.resource_state.json
.claude/.session_claims.json
.claude/.session_validated
.claude/*.lock
.claude/dashboard.html
.claude/github-star-reminder.txt
.claude/llm-provider.txt

# ===================
# Editor / IDE
# ===================
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ===================
# OS Generated
# ===================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================
# Editor backup files
# ===================
*.bak
*.backup
*.old
*.orig

# ===================
# Logs and Temp
# ===================
*.tmp
*.temp
.cache/

# Test debug scratch
packages/*/output.txt
packages/*/test_debug.js
test_*.js
*.json.bak

