_bmad/
_bmad-output/
_bmad-backup-*/
packages/wizard/src/
packages/wizard/dist/
packages/wizard/tests/

# ===================
# Node.js
# ===================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ===================
# Build Output
# ===================
dist/
build/
*.tsbuildinfo
*.map

# Package distribution artifacts
*.tgz
*.tar.gz
*.sha256
*.sbom.json

# Test coverage
coverage/

# ===================
# Environment Files
# ===================
.env
.env.local
.env.*.local
*.env

# ===================
# Security Keys & Certificates
# ===================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
*.pub

# ===================
# Internal team directory (CLAUDE.md: dev/planning/qa/security)
# ===================
team/

# ===================
# Claude Code local settings
# ===================
.claude/settings.local.json
.claude/audio/
.claude/projects/
.claude/logs/
